/*
 * The symbols of libuapi16.so: the functions uapi16.h declares, each under
 * the node of the release that added it. Nothing else is exported.
 *
 * A node is never changed once it is released. A release that adds
 * functions adds a node for them, which names the node before it:
 *
 *     LIBUAPI16_0.1.1 {
 *     global:
 *             uapi16_...;
 *     } LIBUAPI16_0.1.0;
 */

LIBUAPI16_0.1.0 {
global:
        uapi16_manifest_options_new;
